// #033473
// #012619
// #01260A
// #01400B
// #0D0D0D
[
	{
		"layer": "top", // Waybar at top layer
		"output": "DP-1",
		"position": "bottom", // Waybar position (top|bottom|left|right)
		"height": 30, // Waybar height (to be removed for auto height)
		// "width": 1280, // Waybar width
		"spacing": 0, // Gaps between modules (4px)
		"modules-left": [
			"wlr/taskbar",
			"hyprland/workspaces",
		],
		"modules-center": [
			// "hyprland/window"
			"clock"
		],
		"modules-right": [
			"custom/stock",
			"custom/media",
			// "custom/media",
			// "mpd",
			// "idle_inhibitor",
			"pulseaudio",
			"custom/output",
			// "bluetooth",
			"custom/sunset",
			"custom/gamma",
			"custom/weather",
			"cpu",
			"memory",
			"temperature",
			"network",
			"hyprland/language"
			// "keyboard-state",
			// "battery",
			// "battery#bat2",
			// "tray"
		],
		"include": [
			"~/.config/waybar/modules/taskbar.jsonc",
			"~/.config/waybar/modules/clock.jsonc",
			"~/.config/waybar/modules/stock.jsonc",
			"~/.config/waybar/modules/media.jsonc",
			"~/.config/waybar/modules/pulseaudio.jsonc",
			"~/.config/waybar/modules/output.jsonc",
			"~/.config/waybar/modules/gamma.jsonc",
			"~/.config/waybar/modules/sunset.jsonc",
			"~/.config/waybar/modules/weather.jsonc",
			"~/.config/waybar/modules/cpu.jsonc",
			"~/.config/waybar/modules/memory.jsonc",
			"~/.config/waybar/modules/temperature.jsonc",
			"~/.config/waybar/modules/network.jsonc",
			"~/.config/waybar/modules/keyboard.jsonc",
			"~/.config/waybar/modules/language.jsonc",
		],
	},
	{
		"layer": "top", // Waybar at top layer
		"output": ["DP-2", "DP-3", "HDMI-A-1"],
		"position": "bottom", // Waybar position (top|bottom|left|right)
		"height": 30, // Waybar height (to be removed for auto height)
		"spacing": 0, // Gaps between modules (4px)
		"modules-left": [
			"wlr/taskbar",
			"hyprland/workspaces",
		],
		"modules-center": [
			"clock"
		],
		"modules-right": [
			"pulseaudio",
			"custom/output",
			"custom/sunset",
			"custom/gamma",
			"cpu",
			"memory",
			"temperature",
			"network",
			"hyprland/language"
		],
		"include": [
			"~/.config/waybar/modules/taskbar.jsonc",
			"~/.config/waybar/modules/clock.jsonc",
			"~/.config/waybar/modules/stock.jsonc",
			"~/.config/waybar/modules/media.jsonc",
			"~/.config/waybar/modules/pulseaudio.jsonc",
			"~/.config/waybar/modules/output.jsonc",
			"~/.config/waybar/modules/sunset.jsonc",
			"~/.config/waybar/modules/gamma.jsonc",
			"~/.config/waybar/modules/weather.jsonc",
			"~/.config/waybar/modules/cpu.jsonc",
			"~/.config/waybar/modules/memory.jsonc",
			"~/.config/waybar/modules/temperature.jsonc",
			"~/.config/waybar/modules/network.jsonc",
			"~/.config/waybar/modules/keyboard.jsonc",
			"~/.config/waybar/modules/language.jsonc",
		],
	},
]
