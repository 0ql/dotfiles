#!/bin/sh
# Usage: audio-output status|set <sink>|gen
# status: print the current default output's name (for waybar), and
#         rebuild the waybar dropdown when outputs are plugged in/out
# set:    make <sink> the default and move everything playing over to it
# gen:    write the waybar dropdown (menu file + module config)

waybar_dir=~/.config/waybar
module=$waybar_dir/modules/output.jsonc
menu=$waybar_dir/modules/output-menu.xml

short() {
	sed -E 's/^.*\(HDMI\) \[(.*)\]$/HDMI monitor (\1)/; s/ (Analog|Digital) Stereo.*$//; s/ High Definition Audio Controller//'
}

sinks() {
	pactl --format=json list sinks | jq -r '.[] | "\(.name)\t\(.description)"'
}

gen() {
	list=$(sinks)
	{
		echo '<?xml version="1.0" encoding="UTF-8"?>'
		echo '<!-- generated by ~/.local/bin/audio-output, do not edit -->'
		echo '<interface><object class="GtkMenu" id="menu">'
		i=0
		echo "$list" | while IFS="$(printf '\t')" read -r name desc; do
			label=$(echo "$desc" | short | sed 's/&/\&amp;/g; s/</\&lt;/g')
			echo "<child><object class=\"GtkMenuItem\" id=\"sink$i\"><property name=\"label\">$label</property></object></child>"
			i=$((i + 1))
		done
		echo '</object></interface>'
	} > "$menu"
	actions=$(echo "$list" | cut -f1 | jq -R . | jq -s '
		to_entries | map({key: "sink\(.key)", value: "~/.local/bin/audio-output set \(.value)"}) | from_entries')
	jq -n --argjson actions "$actions" --arg menu "$menu" --arg sinks "$(echo "$list" | cut -f1)" '{
		"custom/output": {
			"format": "󰓃  {}",
			"exec": "~/.local/bin/audio-output status",
			"interval": 5,
			"signal": 6,
			"tooltip-format": "Click to choose audio output",
			"menu": "on-click",
			"menu-file": $menu,
			"menu-actions": $actions,
			"sinks": $sinks
		}
	}' > "$module"
}

case "$1" in
	status)
		# rebuild the dropdown if the list of outputs changed
		if [ "$(jq -r '."custom/output".sinks' "$module" 2>/dev/null)" != "$(sinks | cut -f1)" ]; then
			gen && pkill -SIGUSR2 waybar
		fi
		default=$(pactl get-default-sink)
		sinks | awk -F'\t' -v d="$default" '$1==d{print $2}' | short
		;;
	set)
		[ -z "$2" ] && exit 1
		pactl set-default-sink "$2" || exit 1
		pactl list sink-inputs short | cut -f1 | while read -r input; do
			pactl move-sink-input "$input" "$2"
		done
		pkill -RTMIN+6 waybar
		;;
	gen)
		gen
		;;
esac
